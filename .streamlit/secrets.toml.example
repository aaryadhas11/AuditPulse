# Streamlit Community Cloud Secrets Configuration Template
# In Streamlit Cloud: App Settings -> Secrets (paste contents below)
# In Local Development: Copy this file to .streamlit/secrets.toml

# Google Gemini API Key for Multimodal Vision & Forensic Extraction
GEMINI_API_KEY = "your-gemini-api-key-here"

# MySQL Database Connection Credentials
DB_HOST = "your-mysql-host.example.com"
DB_USER = "your-database-username"
DB_PASSWORD = "your-database-password"
DB_NAME = "auditpulse"
DB_PORT = 3306

# Optional Administrator Gateway Configuration
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "your-secure-admin-password"
